# ─── Telegram Bot ─────────────────────────────────────────────────────────────
# ВАЖНО: всё после символа # в значении считается комментарием и отбрасывается
# (BOT_TOKEN=abc # мой токен → токен "abc"). Не используйте # в токенах/паролях.
BOT_TOKEN=your_bot_token_here
ALLOWED_USERS=123456789,987654321

# ─── WDTT Server ─────────────────────────────────────────────────────────────
SERVER_URL=https://127.0.0.1:2860/wdtt
SERVER_NAME=WDTT
SERVER_USERNAME=admin
SERVER_PASSWORD=wdtt

# ─── CSQTT (optional) ────────────────────────────────────────────────────────
# UDP-порт CSQTT-сервера для ссылок csqtt:// (по умолчанию 46000).
# CSQTT_PORT=46000

# ─── Alerts ───────────────────────────────────────────────────────────────────
ALERT_WDTT_DOWN=true
ALERT_XRAY_DOWN=true
ALERT_USERS_LIMIT_PCT=80

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# LOG_FILE=/var/log/wdtt-bot.log
# LOG_MAX_MB=10
# LOG_BACKUPS=3
# NO_COLOR=1

# ─── Healthcheck heartbeat (optional) ─────────────────────────────────────────
# Файл обновляется ботом каждые 20с; Docker HEALTHCHECK проверяет его.
# WDTT_BOT_HEARTBEAT_PATH=/tmp/healthy

# ─── Timezone ─────────────────────────────────────────────────────────────────
TZ=Europe/Moscow

# ─── Telegram Proxy (optional) ────────────────────────────────────────────────
# TELEGRAM_PROXY_URL=socks5://user:pass@host:port

# ─── Database path (optional) ─────────────────────────────────────────────────
# Без Docker переменная не обязательна (по умолчанию ./wdtt_bot.db).
# В docker-compose.yml она уже задана: WDTT_BOT_DB_PATH=/app/data/wdtt_bot.db
# WDTT_BOT_DB_PATH=/path/to/wdtt_bot.db
