# ─── Telegram Bot ─────────────────────────────────────────────────────────────
BOT_TOKEN=your_bot_token_here
ALLOWED_USERS=123456789,987654321

# ─── WDTT Server (single) ────────────────────────────────────────────────────
SERVER_URL=https://127.0.0.1:2860/wdtt
SERVER_NAME=WDTT
SERVER_USERNAME=admin
SERVER_PASSWORD=wdtt

# ─── Multi-server (optional) ─────────────────────────────────────────────────
# SERVER_1_URL=https://10.0.0.1:2860/wdtt
# SERVER_1_NAME=Primary
# SERVER_1_USERNAME=admin
# SERVER_1_PASSWORD=wdtt
# SERVER_1_GROUP=HA
# SERVER_2_URL=https://10.0.0.2:2860/wdtt
# SERVER_2_NAME=Secondary
# SERVER_2_USERNAME=admin
# SERVER_2_PASSWORD=wdtt
# SERVER_2_GROUP=HA

# ─── Alerts ───────────────────────────────────────────────────────────────────
ALERT_WDTT_DOWN=true
ALERT_XRAY_DOWN=true
ALERT_USERS_LIMIT_PCT=80

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# LOG_FILE=/var/log/wdtt-bot.log
# LOG_MAX_MB=10
# LOG_BACKUPS=3
# NO_COLOR=1

# ─── Timezone ─────────────────────────────────────────────────────────────────
TZ=Europe/Moscow

# ─── Telegram Proxy (optional) ────────────────────────────────────────────────
# TELEGRAM_PROXY_URL=socks5://user:pass@host:port

# ─── Database path (optional) ─────────────────────────────────────────────────
# WDTT_BOT_DB_PATH=/path/to/wdtt_bot.db
